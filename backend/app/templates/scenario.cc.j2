using namespace ns3;

NS_LOG_COMPONENT_DEFINE("{{ component }}");

{% if rpl %}
static void
PrintDodag(NodeContainer nodes)
{
    Ptr<OutputStreamWrapper> stream = Create<OutputStreamWrapper>(&std::cout);
    for (auto i = nodes.Begin(); i != nodes.End(); i++)
    {
        Ptr<rpl::RplRoutingProtocol> rpl = (*i)->GetObject<rpl::RplRoutingProtocol>();
        rpl->PrintRoutingTable(stream);
    }
}

{% if has_ping %}
// With RPL every node forms its global address through SLAAC at run time, so a
// ping target has no address to name at configuration time; resolve it once
// the DODAG has settled instead.
static Ipv6Address
Ns3EditGlobalAddressOf(Ptr<Node> node)
{
    Ptr<Ipv6> ipv6 = node->GetObject<Ipv6>();
    for (uint32_t i = 0; ipv6 && i < ipv6->GetNInterfaces(); i++)
    {
        for (uint32_t j = 0; j < ipv6->GetNAddresses(i); j++)
        {
            Ipv6Address addr = ipv6->GetAddress(i, j).GetAddress();
            if (!addr.IsLinkLocal() && !addr.IsLocalhost() && addr != Ipv6Address::GetAny())
            {
                return addr;
            }
        }
    }
    return Ipv6Address::GetAny();
}

{% for app in apps if app.kind == 'ping' %}
static void
{{ app.cvar }}Start(NodeContainer nodes)
{
    // Wait for the DODAG to actually converge before pinging, retrying rather
    // than failing on an early start time: the target must have SLAACed its
    // global address (so it can be named), and the root must hold a DAO from
    // every other node (so a route to the target exists). The root's own
    // address settles well before the rest of the DODAG does, so checking the
    // address alone would fire the ping too early and lose every packet.
    Ptr<rpl::RplRoutingProtocol> rootRpl =
        nodes.Get({{ rpl.root_index }})->GetObject<rpl::RplRoutingProtocol>();
    Ipv6Address target = Ns3EditGlobalAddressOf(nodes.Get({{ app.to_index }}));
    if (target.IsAny() || rootRpl->GetTopologySize() + 1 < nodes.GetN())
    {
        Simulator::Schedule(Seconds(1.0), &{{ app.cvar }}Start, nodes);
        return;
    }

    PingHelper {{ app.cvar }}(target);
    {{ app.cvar }}.SetAttribute("Count", UintegerValue({{ app.count }}));
    {{ app.cvar }}.SetAttribute("Interval", TimeValue(Seconds({{ app.interval }})));
    ApplicationContainer {{ app.cvar }}Apps = {{ app.cvar }}.Install(nodes.Get({{ app.from_index }}));
    {{ app.cvar }}Apps.Start(Seconds(0));
    {{ app.cvar }}Apps.Stop(Seconds({{ app.stop }} - {{ app.start }}));
}

{% endfor %}
{% endif %}
{% endif %}
int
main(int argc, char** argv)
{
    CommandLine cmd(__FILE__);
    cmd.Parse(argc, argv);

    RngSeedManager::SetSeed({{ seed }});
{% for lc in log_components %}
    LogComponentEnable("{{ lc }}", LogLevel(LOG_LEVEL_INFO | LOG_PREFIX_TIME | LOG_PREFIX_NODE));
{% endfor %}

    NodeContainer nodes;
    nodes.Create({{ nodes | length }});

    // Positions come straight from the editor canvas (px * scale = metres).
    MobilityHelper mobility;
    Ptr<ListPositionAllocator> positions = CreateObject<ListPositionAllocator>();
{% for n in nodes %}
    positions->Add(Vector({{ '%.1f' | format(n.x) }}, {{ '%.1f' | format(n.y) }}, 0.0)); // {{ n.name }}
{% endfor %}
    mobility.SetPositionAllocator(positions);
    mobility.SetMobilityModel("ns3::ConstantPositionMobilityModel");
    mobility.Install(nodes);

{% for net in networks %}
    // Network "{{ net.id }}" ({{ net.type }})
    NodeContainer {{ net.cvar }}Nodes;
{% for mi in net.member_indices %}
    {{ net.cvar }}Nodes.Add(nodes.Get({{ mi }}));
{% endfor %}
{% if net.type == 'p2p' %}
    PointToPointHelper {{ net.cvar }}Helper;
    {{ net.cvar }}Helper.SetDeviceAttribute("DataRate", StringValue("{{ net.data_rate }}"));
    {{ net.cvar }}Helper.SetChannelAttribute("Delay", StringValue("{{ net.delay }}"));
    NetDeviceContainer {{ net.cvar }}Devices = {{ net.cvar }}Helper.Install({{ net.cvar }}Nodes);
{% elif net.type == 'csma' %}
    CsmaHelper {{ net.cvar }}Helper;
    {{ net.cvar }}Helper.SetChannelAttribute("DataRate", StringValue("{{ net.data_rate }}"));
    {{ net.cvar }}Helper.SetChannelAttribute("Delay", StringValue("{{ net.delay }}"));
    NetDeviceContainer {{ net.cvar }}Devices = {{ net.cvar }}Helper.Install({{ net.cvar }}Nodes);
{% elif net.type == 'wifiAdhoc' or net.type == 'wifiInfra' %}
    YansWifiChannelHelper {{ net.cvar }}Channel = YansWifiChannelHelper::Default();
    YansWifiPhyHelper {{ net.cvar }}Phy;
    {{ net.cvar }}Phy.SetChannel({{ net.cvar }}Channel.Create());
    WifiHelper {{ net.cvar }}Wifi;
    {{ net.cvar }}Wifi.SetStandard({{ net.standard }});
    WifiMacHelper {{ net.cvar }}Mac;
{% if net.infra %}
    Ssid {{ net.cvar }}Ssid("{{ net.ssid }}");
    NetDeviceContainer {{ net.cvar }}Devices;
{% for mi in net.member_indices %}
{% if loop.index0 == net.ap_member_pos %}
    {{ net.cvar }}Mac.SetType("ns3::ApWifiMac", "Ssid", SsidValue({{ net.cvar }}Ssid));
{% else %}
    {{ net.cvar }}Mac.SetType("ns3::StaWifiMac", "Ssid", SsidValue({{ net.cvar }}Ssid));
{% endif %}
    {{ net.cvar }}Devices.Add({{ net.cvar }}Wifi.Install({{ net.cvar }}Phy, {{ net.cvar }}Mac, nodes.Get({{ mi }})));
{% endfor %}
{% else %}
    {{ net.cvar }}Mac.SetType("ns3::AdhocWifiMac");
    NetDeviceContainer {{ net.cvar }}Devices =
        {{ net.cvar }}Wifi.Install({{ net.cvar }}Phy, {{ net.cvar }}Mac, {{ net.cvar }}Nodes);
{% endif %}
{% elif net.type == 'lrwpan' %}
    LrWpanHelper {{ net.cvar }}Helper;
    {{ net.cvar }}Helper.SetPropagationDelayModel("ns3::ConstantSpeedPropagationDelayModel");
    {{ net.cvar }}Helper.AddPropagationLossModel("{{ net.loss_model }}");
    NetDeviceContainer {{ net.cvar }}Devices = {{ net.cvar }}Helper.Install({{ net.cvar }}Nodes);
    {{ net.cvar }}Helper.CreateAssociatedPan({{ net.cvar }}Devices, {{ net.pan_id }});
{% if net.error_model %}
    // Without an error model the LQI stays pinned at the perfect default and
    // MRHOF's ETX would be indistinguishable from a hop count.
    Ptr<lrwpan::LrWpanErrorModel> {{ net.cvar }}ErrorModel = CreateObject<lrwpan::LrWpanErrorModel>();
    for (auto i = {{ net.cvar }}Devices.Begin(); i != {{ net.cvar }}Devices.End(); i++)
    {
        DynamicCast<lrwpan::LrWpanNetDevice>(*i)->GetPhy()->SetErrorModel({{ net.cvar }}ErrorModel);
    }
{% endif %}
{% endif %}

{% endfor %}
{% if rpl %}
    RplHelper rplHelper;
{% if rpl.mrhof %}
    rplHelper.Set("Ocp", UintegerValue(rpl::RPL_OCP_MRHOF));
{% endif %}
{% if rpl.enable_lql %}
    rplHelper.Set("EnableLql", BooleanValue(true));
{% endif %}
    InternetStackHelper internet;
    internet.SetRoutingHelper(rplHelper);
    internet.Install(nodes);
{% else %}
    InternetStackHelper internet;
    internet.Install(nodes);
{% endif %}
{% for net in networks if net.type == 'lrwpan' %}

    // Route-over 6LoWPAN: the IPv6 interfaces sit on the 6LoWPAN devices.
    SixLowPanHelper {{ net.cvar }}Sixlowpan;
    NetDeviceContainer {{ net.cvar }}SlpDevices = {{ net.cvar }}Sixlowpan.Install({{ net.cvar }}Devices);
{% endfor %}

{% if ipv6 %}
{% if rpl %}
    // No address is assigned here: the root SLAACs its own from RootPrefix and
    // disseminates it over the DODAG (RFC 6550 section 6.7.10's Prefix
    // Information option), and every other node SLAACs its own address on it in
    // turn.
    Ipv6AddressHelper ipv6Helper;
{% for net in networks %}
    Ipv6InterfaceContainer {{ net.cvar }}Ifaces =
        ipv6Helper.AssignWithoutAddress({{ net.cvar }}{{ 'SlpDevices' if net.type == 'lrwpan' else 'Devices' }});
    for (uint32_t i = 0; i < {{ net.cvar }}Ifaces.GetN(); i++)
    {
        {{ net.cvar }}Ifaces.SetForwarding(i, true);
    }
{% endfor %}
{% else %}
    // Not 2001:db8::/32: Ipv6L3Protocol::IpForward() drops the documentation
    // prefix, so multi-hop routes would never work with it.
    Ipv6AddressHelper ipv6Helper;
{% for net in networks %}
    ipv6Helper.SetBase(Ipv6Address("{{ net.ipv6_base }}"), Ipv6Prefix(64));
    Ipv6InterfaceContainer {{ net.cvar }}Ifaces =
        ipv6Helper.Assign({{ net.cvar }}{{ 'SlpDevices' if net.type == 'lrwpan' else 'Devices' }});
    for (uint32_t i = 0; i < {{ net.cvar }}Ifaces.GetN(); i++)
    {
        {{ net.cvar }}Ifaces.SetForwarding(i, true);
    }
{% endfor %}
{% endif %}
{% else %}
    Ipv4AddressHelper ipv4Helper;
{% for net in networks %}
    ipv4Helper.SetBase("{{ net.ipv4_base }}", "255.255.255.0");
    Ipv4InterfaceContainer {{ net.cvar }}Ifaces = ipv4Helper.Assign({{ net.cvar }}Devices);
{% endfor %}
{% endif %}
{% if rpl %}

    // The DODAGID is the root's first global address: the root SLAACs it from
    // this prefix and disseminates it over the DODAG.
    rplHelper.SetRoot(nodes.Get({{ rpl.root_index }}), Ipv6Address("{{ rpl.root_prefix }}"), 64);
{% endif %}
{% if global_routing %}

    Ipv4GlobalRoutingHelper::PopulateRoutingTables();
{% endif %}

{% for app in apps %}
{% if app.kind == 'ping' %}
{% if rpl %}
    // App "{{ app.id }}" (ping): scheduled rather than installed up front, since
    // the target's SLAAC address only exists once the DODAG has settled.
    Simulator::Schedule(Seconds({{ app.start }}), &{{ app.cvar }}Start, nodes);
{% else %}
    // App "{{ app.id }}" (ping)
    PingHelper {{ app.cvar }}({{ app.target }});
    {{ app.cvar }}.SetAttribute("Count", UintegerValue({{ app.count }}));
    {{ app.cvar }}.SetAttribute("Interval", TimeValue(Seconds({{ app.interval }})));
    ApplicationContainer {{ app.cvar }}Apps = {{ app.cvar }}.Install(nodes.Get({{ app.from_index }}));
    {{ app.cvar }}Apps.Start(Seconds({{ app.start }}));
    {{ app.cvar }}Apps.Stop(Seconds({{ app.stop }}));
{% endif %}
{% elif app.kind == 'udpEcho' %}
    // App "{{ app.id }}" (UDP echo)
    UdpEchoServerHelper {{ app.cvar }}Server({{ app.port }});
    ApplicationContainer {{ app.cvar }}ServerApps = {{ app.cvar }}Server.Install(nodes.Get({{ app.server_index }}));
    {{ app.cvar }}ServerApps.Start(Seconds(0.0));
    {{ app.cvar }}ServerApps.Stop(Seconds({{ duration }}));
    UdpEchoClientHelper {{ app.cvar }}Client({{ app.target }}, {{ app.port }});
    {{ app.cvar }}Client.SetAttribute("MaxPackets", UintegerValue({{ app.max_packets }}));
    {{ app.cvar }}Client.SetAttribute("Interval", TimeValue(Seconds({{ app.interval }})));
    {{ app.cvar }}Client.SetAttribute("PacketSize", UintegerValue({{ app.packet_size }}));
    ApplicationContainer {{ app.cvar }}ClientApps = {{ app.cvar }}Client.Install(nodes.Get({{ app.client_index }}));
    {{ app.cvar }}ClientApps.Start(Seconds({{ app.start }}));
    {{ app.cvar }}ClientApps.Stop(Seconds({{ app.stop }}));
{% elif app.kind == 'onoff' %}
    // App "{{ app.id }}" (OnOff -> PacketSink)
    PacketSinkHelper {{ app.cvar }}Sink("ns3::UdpSocketFactory",
                                        {{ app.socket_addr }}({{ app.any_addr }}, {{ app.port }}));
    ApplicationContainer {{ app.cvar }}SinkApps = {{ app.cvar }}Sink.Install(nodes.Get({{ app.to_index }}));
    {{ app.cvar }}SinkApps.Start(Seconds(0.0));
    {{ app.cvar }}SinkApps.Stop(Seconds({{ duration }}));
    OnOffHelper {{ app.cvar }}("ns3::UdpSocketFactory",
                               {{ app.socket_addr }}({{ app.target }}, {{ app.port }}));
    {{ app.cvar }}.SetConstantRate(DataRate("{{ app.data_rate }}"), {{ app.packet_size }});
    ApplicationContainer {{ app.cvar }}Apps = {{ app.cvar }}.Install(nodes.Get({{ app.from_index }}));
    {{ app.cvar }}Apps.Start(Seconds({{ app.start }}));
    {{ app.cvar }}Apps.Stop(Seconds({{ app.stop }}));
{% endif %}

{% endfor %}
{% if pcap %}
{% for net in networks %}
{% if net.type == 'p2p' or net.type == 'csma' %}
    {{ net.cvar }}Helper.EnablePcap("{{ slug }}", {{ net.cvar }}Devices);
{% elif net.type == 'wifiAdhoc' or net.type == 'wifiInfra' %}
    {{ net.cvar }}Phy.EnablePcap("{{ slug }}", {{ net.cvar }}Devices);
{% elif net.type == 'lrwpan' %}
    {{ net.cvar }}Helper.EnablePcap("{{ slug }}", {{ net.cvar }}Devices, true);
{% endif %}
{% endfor %}

{% endif %}
{% if rpl %}
    Simulator::Schedule(Seconds({{ duration }} - 1), &PrintDodag, nodes);

{% endif %}
    Simulator::Stop(Seconds({{ duration }}));
    Simulator::Run();
    Simulator::Destroy();

    return 0;
}
