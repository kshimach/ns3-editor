using namespace ns3;

NS_LOG_COMPONENT_DEFINE("{{ component }}");

{% if rpl %}
static void
PrintDodag(NodeContainer nodes)
{
    Ptr<OutputStreamWrapper> stream = Create<OutputStreamWrapper>(&std::cout);
    for (auto i = nodes.Begin(); i != nodes.End(); i++)
    {
        Ptr<rpl::RplRoutingProtocol> rpl = (*i)->GetObject<rpl::RplRoutingProtocol>();
        rpl->PrintRoutingTable(stream);
    }
}

{% if rpl.table_interval > 0 %}
// One line of JSON per node, behind a marker the editor's run manager picks
// back out of the simulation's stdout. Captured into a std::ostringstream
// and re-emitted with the marker prepended, rather than written straight to
// std::cout, so that the marker is guaranteed to sit on the same line as the
// object it introduces.
static void
DumpRplTables(NodeContainer nodes, Time interval)
{
    for (auto i = nodes.Begin(); i != nodes.End(); i++)
    {
        Ptr<rpl::RplRoutingProtocol> rpl = (*i)->GetObject<rpl::RplRoutingProtocol>();
        if (!rpl)
        {
            continue;
        }
        std::ostringstream captured;
        Ptr<OutputStreamWrapper> stream = Create<OutputStreamWrapper>(&captured);
        rpl->PrintRoutingTableJson(stream);
        std::string line = captured.str();
        while (!line.empty() && (line.back() == '\n' || line.back() == '\r'))
        {
            line.pop_back();
        }
        std::cout << "##RPLTABLE## " << line << std::endl;
    }
    // Reschedules itself rather than being registered up front for every
    // sampling instant, so the number of pending events stays at one however
    // long the run is.
    Simulator::Schedule(interval, &DumpRplTables, nodes, interval);
}
{% endif %}

{% if has_ping or has_udp_echo or has_onoff or has_aodv_discover or has_p2p_discover %}
// With RPL every node forms its global address through SLAAC at run time, so
// a ping/echo/onoff/discovery target has no address to name at configuration
// time; resolve it once the DODAG has settled instead.
static Ipv6Address
Ns3EditGlobalAddressOf(Ptr<Node> node)
{
    Ptr<Ipv6> ipv6 = node->GetObject<Ipv6>();
    for (uint32_t i = 0; ipv6 && i < ipv6->GetNInterfaces(); i++)
    {
        for (uint32_t j = 0; j < ipv6->GetNAddresses(i); j++)
        {
            Ipv6Address addr = ipv6->GetAddress(i, j).GetAddress();
            if (!addr.IsLinkLocal() && !addr.IsLocalhost() && addr != Ipv6Address::GetAny())
            {
                return addr;
            }
        }
    }
    return Ipv6Address::GetAny();
}

{% for app in apps if app.kind == 'ping' %}
static void
{{ app.cvar }}Start(NodeContainer nodes)
{
    // Wait for the DODAG to actually converge before pinging, retrying rather
    // than failing on an early start time: the target must have SLAACed its
    // global address (so it can be named), the sender must have SLAACed one
    // too (Ipv6L3Protocol::SourceAddressSelection() asserts if it has not),
    // and the root must hold a DAO from every other node (so a route to the
    // target exists). The root's own address settles well before the rest of
    // the DODAG does, so checking the address alone would fire the ping too
    // early and lose every packet.
    Ptr<rpl::RplRoutingProtocol> rootRpl =
        nodes.Get({{ rpl.root_index }})->GetObject<rpl::RplRoutingProtocol>();
    Ipv6Address target = Ns3EditGlobalAddressOf(nodes.Get({{ app.to_index }}));
    bool senderReady = !Ns3EditGlobalAddressOf(nodes.Get({{ app.from_index }})).IsAny();
    if (target.IsAny() || !senderReady || rootRpl->GetTopologySize() + 1 < nodes.GetN())
    {
        Simulator::Schedule(Seconds(1.0), &{{ app.cvar }}Start, nodes);
        return;
    }

    PingHelper {{ app.cvar }}(target);
    {{ app.cvar }}.SetAttribute("Count", UintegerValue({{ app.count }}));
    {{ app.cvar }}.SetAttribute("Interval", TimeValue(Seconds({{ app.interval }})));
    ApplicationContainer {{ app.cvar }}Apps = {{ app.cvar }}.Install(nodes.Get({{ app.from_index }}));
    {{ app.cvar }}Apps.Start(Seconds(0));
    {{ app.cvar }}Apps.Stop(Seconds({{ app.stop }} - {{ app.start }}));
}

{% endfor %}
{% for app in apps if app.kind == 'udpEcho' %}
static void
{{ app.cvar }}Start(NodeContainer nodes)
{
    // Same convergence wait as the ping helper above: the server's address
    // must exist, the client itself must have SLAACed one too
    // (Ipv6L3Protocol::SourceAddressSelection() asserts if it has not), and
    // the root must have heard from every node.
    Ptr<rpl::RplRoutingProtocol> rootRpl =
        nodes.Get({{ rpl.root_index }})->GetObject<rpl::RplRoutingProtocol>();
    Ipv6Address target = Ns3EditGlobalAddressOf(nodes.Get({{ app.server_index }}));
    bool senderReady = !Ns3EditGlobalAddressOf(nodes.Get({{ app.client_index }})).IsAny();
    if (target.IsAny() || !senderReady || rootRpl->GetTopologySize() + 1 < nodes.GetN())
    {
        Simulator::Schedule(Seconds(1.0), &{{ app.cvar }}Start, nodes);
        return;
    }

    UdpEchoClientHelper {{ app.cvar }}Client(target, {{ app.port }});
    {{ app.cvar }}Client.SetAttribute("MaxPackets", UintegerValue({{ app.max_packets }}));
    {{ app.cvar }}Client.SetAttribute("Interval", TimeValue(Seconds({{ app.interval }})));
    {{ app.cvar }}Client.SetAttribute("PacketSize", UintegerValue({{ app.packet_size }}));
    ApplicationContainer {{ app.cvar }}ClientApps =
        {{ app.cvar }}Client.Install(nodes.Get({{ app.client_index }}));
    {{ app.cvar }}ClientApps.Start(Seconds(0));
    {{ app.cvar }}ClientApps.Stop(Seconds({{ app.stop }} - {{ app.start }}));
}

{% endfor %}
{% for app in apps if app.kind == 'onoff' %}
static void
{{ app.cvar }}Start(NodeContainer nodes)
{
    // Same convergence wait as the ping helper above: the sink's address must
    // exist, the sender itself must have SLAACed one too
    // (Ipv6L3Protocol::SourceAddressSelection() asserts if it has not), and
    // the root must have heard from every node.
    Ptr<rpl::RplRoutingProtocol> rootRpl =
        nodes.Get({{ rpl.root_index }})->GetObject<rpl::RplRoutingProtocol>();
    Ipv6Address target = Ns3EditGlobalAddressOf(nodes.Get({{ app.to_index }}));
    bool senderReady = !Ns3EditGlobalAddressOf(nodes.Get({{ app.from_index }})).IsAny();
    if (target.IsAny() || !senderReady || rootRpl->GetTopologySize() + 1 < nodes.GetN())
    {
        Simulator::Schedule(Seconds(1.0), &{{ app.cvar }}Start, nodes);
        return;
    }

    OnOffHelper {{ app.cvar }}("ns3::UdpSocketFactory", Inet6SocketAddress(target, {{ app.port }}));
    {{ app.cvar }}.SetConstantRate(DataRate("{{ app.data_rate }}"), {{ app.packet_size }});
    ApplicationContainer {{ app.cvar }}Apps = {{ app.cvar }}.Install(nodes.Get({{ app.from_index }}));
    {{ app.cvar }}Apps.Start(Seconds(0));
    {{ app.cvar }}Apps.Stop(Seconds({{ app.stop }} - {{ app.start }}));
}

{% endfor %}
{% for app in apps if app.kind == 'aodvDiscover' %}
static void
{{ app.cvar }}Start(NodeContainer nodes)
{
    // AODV-RPL (RFC 9854) route discovery: unlike ping/udpEcho/onoff this does
    // not wait for the whole DODAG's topology to converge -- AODV-RPL floods
    // its own RREQ-Instance independently of the DAO-built tree, so only the
    // origin's own global address (which DiscoverRoute() needs to root the
    // RREQ-Instance) and the target's SLAAC address (passed by value, not
    // resolved later) have to be ready.
    Ptr<rpl::RplRoutingProtocol> origin =
        nodes.Get({{ app.from_index }})->GetObject<rpl::RplRoutingProtocol>();
    Ipv6Address target = Ns3EditGlobalAddressOf(nodes.Get({{ app.to_index }}));
    if (origin->GetGlobalAddress().IsAny() || target.IsAny())
    {
        Simulator::Schedule(Seconds(1.0), &{{ app.cvar }}Start, nodes);
        return;
    }

    origin->DiscoverRoute(target);
}

{% endfor %}
{% for app in apps if app.kind == 'p2pDiscover' %}
static void
{{ app.cvar }}Start(NodeContainer nodes)
{
    // P2P-RPL (RFC 6997) route discovery: the same reasoning as the
    // AODV-RPL discovery helper above -- DiscoverP2pRoute() floods its own
    // temporary DAG independently of the DAO-built tree, so only the
    // origin's own global address (which it needs to root the temporary
    // DAG) and the target's SLAAC address have to be ready.
    Ptr<rpl::RplRoutingProtocol> origin =
        nodes.Get({{ app.from_index }})->GetObject<rpl::RplRoutingProtocol>();
    Ipv6Address target = Ns3EditGlobalAddressOf(nodes.Get({{ app.to_index }}));
    if (origin->GetGlobalAddress().IsAny() || target.IsAny())
    {
        Simulator::Schedule(Seconds(1.0), &{{ app.cvar }}Start, nodes);
        return;
    }

    origin->DiscoverP2pRoute(target);
}

{% endfor %}
{% endif %}
{% endif %}
int
main(int argc, char** argv)
{
    CommandLine cmd(__FILE__);
    cmd.Parse(argc, argv);

    RngSeedManager::SetSeed({{ seed }});
{% for lc in log_components %}
    LogComponentEnable("{{ lc }}", LogLevel(LOG_LEVEL_INFO | LOG_PREFIX_TIME | LOG_PREFIX_NODE));
{% endfor %}

    NodeContainer nodes;
    nodes.Create({{ nodes | length }});

    // Positions come straight from the editor canvas (px * scale = metres).
    MobilityHelper mobility;
    Ptr<ListPositionAllocator> positions = CreateObject<ListPositionAllocator>();
{% for n in nodes %}
    positions->Add(Vector({{ '%.1f' | format(n.x) }}, {{ '%.1f' | format(n.y) }}, 0.0)); // {{ n.name }}
{% endfor %}
    mobility.SetPositionAllocator(positions);
    mobility.SetMobilityModel("ns3::ConstantPositionMobilityModel");
    mobility.Install(nodes);

{% for net in networks %}
    // Network "{{ net.id }}" ({{ net.type }})
    NodeContainer {{ net.cvar }}Nodes;
{% for mi in net.member_indices %}
    {{ net.cvar }}Nodes.Add(nodes.Get({{ mi }}));
{% endfor %}
{% if net.type == 'p2p' %}
    PointToPointHelper {{ net.cvar }}Helper;
    {{ net.cvar }}Helper.SetDeviceAttribute("DataRate", StringValue("{{ net.data_rate }}"));
    {{ net.cvar }}Helper.SetChannelAttribute("Delay", StringValue("{{ net.delay }}"));
    NetDeviceContainer {{ net.cvar }}Devices = {{ net.cvar }}Helper.Install({{ net.cvar }}Nodes);
{% elif net.type == 'csma' %}
    CsmaHelper {{ net.cvar }}Helper;
    {{ net.cvar }}Helper.SetChannelAttribute("DataRate", StringValue("{{ net.data_rate }}"));
    {{ net.cvar }}Helper.SetChannelAttribute("Delay", StringValue("{{ net.delay }}"));
    NetDeviceContainer {{ net.cvar }}Devices = {{ net.cvar }}Helper.Install({{ net.cvar }}Nodes);
{% elif net.type == 'wifiAdhoc' or net.type == 'wifiInfra' %}
    YansWifiChannelHelper {{ net.cvar }}Channel = YansWifiChannelHelper::Default();
    YansWifiPhyHelper {{ net.cvar }}Phy;
    {{ net.cvar }}Phy.SetChannel({{ net.cvar }}Channel.Create());
    WifiHelper {{ net.cvar }}Wifi;
    {{ net.cvar }}Wifi.SetStandard({{ net.standard }});
    WifiMacHelper {{ net.cvar }}Mac;
{% if net.infra %}
    Ssid {{ net.cvar }}Ssid("{{ net.ssid }}");
    NetDeviceContainer {{ net.cvar }}Devices;
{% for mi in net.member_indices %}
{% if loop.index0 == net.ap_member_pos %}
    {{ net.cvar }}Mac.SetType("ns3::ApWifiMac", "Ssid", SsidValue({{ net.cvar }}Ssid));
{% else %}
    {{ net.cvar }}Mac.SetType("ns3::StaWifiMac", "Ssid", SsidValue({{ net.cvar }}Ssid));
{% endif %}
    {{ net.cvar }}Devices.Add({{ net.cvar }}Wifi.Install({{ net.cvar }}Phy, {{ net.cvar }}Mac, nodes.Get({{ mi }})));
{% endfor %}
{% else %}
    {{ net.cvar }}Mac.SetType("ns3::AdhocWifiMac");
    NetDeviceContainer {{ net.cvar }}Devices =
        {{ net.cvar }}Wifi.Install({{ net.cvar }}Phy, {{ net.cvar }}Mac, {{ net.cvar }}Nodes);
{% endif %}
{% elif net.type == 'lrwpan' %}
    LrWpanHelper {{ net.cvar }}Helper;
    {{ net.cvar }}Helper.SetPropagationDelayModel("ns3::ConstantSpeedPropagationDelayModel");
    {{ net.cvar }}Helper.AddPropagationLossModel("{{ net.loss_model }}");
    NetDeviceContainer {{ net.cvar }}Devices = {{ net.cvar }}Helper.Install({{ net.cvar }}Nodes);
    {{ net.cvar }}Helper.CreateAssociatedPan({{ net.cvar }}Devices, {{ net.pan_id }});
{% if net.error_model %}
    // Without an error model the LQI stays pinned at the perfect default and
    // MRHOF's ETX would be indistinguishable from a hop count.
    Ptr<lrwpan::LrWpanErrorModel> {{ net.cvar }}ErrorModel = CreateObject<lrwpan::LrWpanErrorModel>();
    for (auto i = {{ net.cvar }}Devices.Begin(); i != {{ net.cvar }}Devices.End(); i++)
    {
        DynamicCast<lrwpan::LrWpanNetDevice>(*i)->GetPhy()->SetErrorModel({{ net.cvar }}ErrorModel);
    }
{% endif %}
{% endif %}

{% endfor %}
{% if rpl %}
    RplHelper rplHelper;
{% if rpl.mrhof %}
    rplHelper.Set("Ocp", UintegerValue(rpl::RPL_OCP_MRHOF));
{% endif %}
{% if rpl.enable_lql %}
    rplHelper.Set("EnableLql", BooleanValue(true));
{% endif %}
{# Compared against rpl::RplRoutingProtocol::GetTypeId()'s own defaults; only
   emitted when the scenario actually changed one, so an untouched RPL
   scenario's generated code stays as small as it was before these existed. #}
{% if rpl.dis_interval != 30.0 %}
    rplHelper.Set("DisInterval", TimeValue(Seconds({{ rpl.dis_interval }})));
{% endif %}
{% if rpl.dio_interval_min != 4.096 %}
    rplHelper.Set("DioIntervalMin", TimeValue(Seconds({{ rpl.dio_interval_min }})));
{% endif %}
{% if rpl.dio_interval_doublings != 8 %}
    rplHelper.Set("DioIntervalDoublings", UintegerValue({{ rpl.dio_interval_doublings }}));
{% endif %}
{% if rpl.dio_redundancy != 0 %}
    rplHelper.Set("DioRedundancy", UintegerValue({{ rpl.dio_redundancy }}));
{% endif %}
{% if rpl.min_hop_rank_increase != 128 %}
    rplHelper.Set("MinHopRankIncrease", UintegerValue({{ rpl.min_hop_rank_increase }}));
{% endif %}
{% if rpl.dao_interval != 60.0 %}
    rplHelper.Set("DaoInterval", TimeValue(Seconds({{ rpl.dao_interval }})));
{% endif %}
{% if rpl.dao_ack_timeout != 5.0 %}
    rplHelper.Set("DaoAckTimeout", TimeValue(Seconds({{ rpl.dao_ack_timeout }})));
{% endif %}
{% if rpl.dao_retries != 3 %}
    rplHelper.Set("DaoRetries", UintegerValue({{ rpl.dao_retries }}));
{% endif %}
{% if rpl.path_lifetime != 30 %}
    rplHelper.Set("PathLifetime", UintegerValue({{ rpl.path_lifetime }}));
{% endif %}
{% if has_aodv_discover %}
    // AODV-RPL (RFC 9854) route-discovery tuning; see RplConfig's
    // aodv* fields (paced much faster than the base DODAG's own Trickle
    // timer, since a discovery has to finish inside its own 'L' lifetime).
    rplHelper.Set("AodvDioIntervalMin", TimeValue(Seconds({{ rpl.aodv_dio_interval_min }})));
    rplHelper.Set("AodvDioIntervalDoublings", UintegerValue({{ rpl.aodv_dio_interval_doublings }}));
    rplHelper.Set("AodvRankLimit", UintegerValue({{ rpl.aodv_rank_limit }}));
    rplHelper.Set("AodvLifetime", UintegerValue({{ rpl.aodv_lifetime }}));
    rplHelper.Set("AodvRejoinReenable", TimeValue(Seconds({{ rpl.aodv_rejoin_reenable }})));
{% endif %}
{% if has_p2p_discover %}
    // P2P-RPL (RFC 6997) route-discovery tuning; see RplConfig's p2p*
    // fields (paced much faster than the base DODAG's own Trickle timer,
    // since a discovery has to finish inside its own 'L' lifetime).
    rplHelper.Set("P2pDioIntervalMin", TimeValue(Seconds({{ rpl.p2p_dio_interval_min }})));
    rplHelper.Set("P2pDioIntervalDoublings", UintegerValue({{ rpl.p2p_dio_interval_doublings }}));
    rplHelper.Set("P2pDioRedundancy", UintegerValue({{ rpl.p2p_dio_redundancy }}));
    rplHelper.Set("P2pMaxRank", UintegerValue({{ rpl.p2p_max_rank }}));
    rplHelper.Set("P2pLifetime", UintegerValue({{ rpl.p2p_lifetime }}));
    rplHelper.Set("P2pDroAckRequested", BooleanValue({{ 'true' if rpl.p2p_dro_ack_requested else 'false' }}));
    rplHelper.Set("P2pDroAckWaitTime", TimeValue(Seconds({{ rpl.p2p_dro_ack_wait_time }})));
    rplHelper.Set("P2pDroMaxRetransmissions", UintegerValue({{ rpl.p2p_dro_max_retransmissions }}));
{% endif %}
    InternetStackHelper internet;
    internet.SetRoutingHelper(rplHelper);
    internet.Install(nodes);
{% else %}
    InternetStackHelper internet;
    internet.Install(nodes);
{% endif %}
{% for net in networks if net.type == 'lrwpan' %}

    // Route-over 6LoWPAN: the IPv6 interfaces sit on the 6LoWPAN devices.
    SixLowPanHelper {{ net.cvar }}Sixlowpan;
    NetDeviceContainer {{ net.cvar }}SlpDevices = {{ net.cvar }}Sixlowpan.Install({{ net.cvar }}Devices);
{% endfor %}

{% if ipv6 %}
{% if rpl %}
    // No address is assigned here: the root SLAACs its own from RootPrefix and
    // disseminates it over the DODAG (RFC 6550 section 6.7.10's Prefix
    // Information option), and every other node SLAACs its own address on it in
    // turn.
    Ipv6AddressHelper ipv6Helper;
{% for net in networks %}
    Ipv6InterfaceContainer {{ net.cvar }}Ifaces =
        ipv6Helper.AssignWithoutAddress({{ net.cvar }}{{ 'SlpDevices' if net.type == 'lrwpan' else 'Devices' }});
    for (uint32_t i = 0; i < {{ net.cvar }}Ifaces.GetN(); i++)
    {
        {{ net.cvar }}Ifaces.SetForwarding(i, true);
    }
{% endfor %}
{% else %}
    // Not 2001:db8::/32: Ipv6L3Protocol::IpForward() drops the documentation
    // prefix, so multi-hop routes would never work with it.
    Ipv6AddressHelper ipv6Helper;
{% for net in networks %}
    ipv6Helper.SetBase(Ipv6Address("{{ net.ipv6_base }}"), Ipv6Prefix(64));
    Ipv6InterfaceContainer {{ net.cvar }}Ifaces =
        ipv6Helper.Assign({{ net.cvar }}{{ 'SlpDevices' if net.type == 'lrwpan' else 'Devices' }});
    for (uint32_t i = 0; i < {{ net.cvar }}Ifaces.GetN(); i++)
    {
        {{ net.cvar }}Ifaces.SetForwarding(i, true);
    }
{% endfor %}
{% endif %}
{% else %}
    Ipv4AddressHelper ipv4Helper;
{% for net in networks %}
    ipv4Helper.SetBase("{{ net.ipv4_base }}", "255.255.255.0");
    Ipv4InterfaceContainer {{ net.cvar }}Ifaces = ipv4Helper.Assign({{ net.cvar }}Devices);
{% endfor %}
{% endif %}
{% if rpl %}

    // The DODAGID is the root's first global address: the root SLAACs it from
    // this prefix and disseminates it over the DODAG.
    rplHelper.SetRoot(nodes.Get({{ rpl.root_index }}), Ipv6Address("{{ rpl.root_prefix }}"), 64);
{% endif %}
{% if global_routing %}

    Ipv4GlobalRoutingHelper::PopulateRoutingTables();
{% endif %}

{% for app in apps %}
{% if app.kind == 'ping' %}
{% if rpl %}
    // App "{{ app.id }}" (ping): scheduled rather than installed up front, since
    // the target's SLAAC address only exists once the DODAG has settled.
    Simulator::Schedule(Seconds({{ app.start }}), &{{ app.cvar }}Start, nodes);
{% else %}
    // App "{{ app.id }}" (ping)
    PingHelper {{ app.cvar }}({{ app.target }});
    {{ app.cvar }}.SetAttribute("Count", UintegerValue({{ app.count }}));
    {{ app.cvar }}.SetAttribute("Interval", TimeValue(Seconds({{ app.interval }})));
    ApplicationContainer {{ app.cvar }}Apps = {{ app.cvar }}.Install(nodes.Get({{ app.from_index }}));
    {{ app.cvar }}Apps.Start(Seconds({{ app.start }}));
    {{ app.cvar }}Apps.Stop(Seconds({{ app.stop }}));
{% endif %}
{% elif app.kind == 'udpEcho' %}
    // App "{{ app.id }}" (UDP echo)
    UdpEchoServerHelper {{ app.cvar }}Server({{ app.port }});
    ApplicationContainer {{ app.cvar }}ServerApps = {{ app.cvar }}Server.Install(nodes.Get({{ app.server_index }}));
    {{ app.cvar }}ServerApps.Start(Seconds(0.0));
    {{ app.cvar }}ServerApps.Stop(Seconds({{ duration }}));
{% if rpl %}
    // Client scheduled rather than installed up front, since the server's
    // SLAAC address only exists once the DODAG has settled.
    Simulator::Schedule(Seconds({{ app.start }}), &{{ app.cvar }}Start, nodes);
{% else %}
    UdpEchoClientHelper {{ app.cvar }}Client({{ app.target }}, {{ app.port }});
    {{ app.cvar }}Client.SetAttribute("MaxPackets", UintegerValue({{ app.max_packets }}));
    {{ app.cvar }}Client.SetAttribute("Interval", TimeValue(Seconds({{ app.interval }})));
    {{ app.cvar }}Client.SetAttribute("PacketSize", UintegerValue({{ app.packet_size }}));
    ApplicationContainer {{ app.cvar }}ClientApps = {{ app.cvar }}Client.Install(nodes.Get({{ app.client_index }}));
    {{ app.cvar }}ClientApps.Start(Seconds({{ app.start }}));
    {{ app.cvar }}ClientApps.Stop(Seconds({{ app.stop }}));
{% endif %}
{% elif app.kind == 'onoff' %}
    // App "{{ app.id }}" (OnOff -> PacketSink)
    PacketSinkHelper {{ app.cvar }}Sink("ns3::UdpSocketFactory",
                                        {{ app.socket_addr }}({{ app.any_addr }}, {{ app.port }}));
    ApplicationContainer {{ app.cvar }}SinkApps = {{ app.cvar }}Sink.Install(nodes.Get({{ app.to_index }}));
    {{ app.cvar }}SinkApps.Start(Seconds(0.0));
    {{ app.cvar }}SinkApps.Stop(Seconds({{ duration }}));
{% if rpl %}
    // Sender scheduled rather than installed up front, since the sink's
    // SLAAC address only exists once the DODAG has settled.
    Simulator::Schedule(Seconds({{ app.start }}), &{{ app.cvar }}Start, nodes);
{% else %}
    OnOffHelper {{ app.cvar }}("ns3::UdpSocketFactory",
                               {{ app.socket_addr }}({{ app.target }}, {{ app.port }}));
    {{ app.cvar }}.SetConstantRate(DataRate("{{ app.data_rate }}"), {{ app.packet_size }});
    ApplicationContainer {{ app.cvar }}Apps = {{ app.cvar }}.Install(nodes.Get({{ app.from_index }}));
    {{ app.cvar }}Apps.Start(Seconds({{ app.start }}));
    {{ app.cvar }}Apps.Stop(Seconds({{ app.stop }}));
{% endif %}
{% elif app.kind == 'aodvDiscover' %}
    // App "{{ app.id }}" (AODV-RPL discovery, RFC 9854)
    Simulator::Schedule(Seconds({{ app.start }}), &{{ app.cvar }}Start, nodes);
{% elif app.kind == 'p2pDiscover' %}
    // App "{{ app.id }}" (P2P-RPL discovery, RFC 6997)
    Simulator::Schedule(Seconds({{ app.start }}), &{{ app.cvar }}Start, nodes);
{% endif %}

{% endfor %}
{% if pcap %}
{% for net in networks %}
{% if net.type == 'p2p' or net.type == 'csma' %}
    {{ net.cvar }}Helper.EnablePcap("{{ slug }}", {{ net.cvar }}Devices);
{% elif net.type == 'wifiAdhoc' or net.type == 'wifiInfra' %}
    {{ net.cvar }}Phy.EnablePcap("{{ slug }}", {{ net.cvar }}Devices);
{% elif net.type == 'lrwpan' %}
    {{ net.cvar }}Helper.EnablePcap("{{ slug }}", {{ net.cvar }}Devices, true);
{% endif %}
{% endfor %}

{% endif %}
{% if rpl %}
{% if rpl.table_interval > 0 %}
    // The first sample is one interval in, not at t=0: nothing has been
    // exchanged yet at that point, so every node would report the same empty
    // state. DumpRplTables() reschedules itself from there.
    Simulator::Schedule(Seconds({{ rpl.table_interval }}),
                        &DumpRplTables,
                        nodes,
                        Seconds({{ rpl.table_interval }}));
{% endif %}
    // Kept whatever the sampling interval is: this is the readable form, and
    // it is what the run log itself carries.
    Simulator::Schedule(Seconds({{ duration }} - 1), &PrintDodag, nodes);

{% endif %}
    Simulator::Stop(Seconds({{ duration }}));
    Simulator::Run();
    Simulator::Destroy();

    return 0;
}
